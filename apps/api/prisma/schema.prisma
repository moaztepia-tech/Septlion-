generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationType {
  BUYER
  SELLER
  BOTH
}

enum UserRole {
  BUYER
  SALES
  ADMIN
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum CatalogVisibility {
  PUBLIC
  PRIVATE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum RFQStatus {
  DRAFT
  OPEN
  QUOTED
  NEGOTIATING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  REVISED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum QuoteRevisionStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum OrderIntentStatus {
  CREATED
  CONFIRMED
  CANCELLED
}

enum TradeTransactionStatus {
  PENDING_COMMIT
  COMMITTED
  IN_EXECUTION
  READY_TO_SHIP
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RECEIPT_REVIEW
  COMPLETED
  ON_HOLD
  CLAIM_OPEN
  CANCELLED
}

enum ChangeOrderStatus {
  PROPOSED
  APPROVED
  REJECTED
  SUPERSEDED
}

enum TradeEventVisibility {
  INTERNAL
  BUYER
  COUNTERPARTY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  LOGOUT
  RFQ_CREATED
  RFQ_UPDATED
  QUOTE_CREATED
  QUOTE_SUBMITTED
  QUOTE_UPDATED
  ORDER_INTENT_CREATED
  ORDER_INTENT_UPDATED
  DOCUMENT_UPLOADED
  MESSAGE_SENT
  NOTIFICATION_READ
}

enum WorkspaceEntityType {
  RFQ
  QUOTE
  ORDER_INTENT
}

enum DocumentStatus {
  PENDING
  READY
  QUARANTINED
  DELETED
}

enum MessageType {
  TEXT
  SYSTEM
  DOCUMENT
}

enum NotificationType {
  RFQ
  QUOTE
  NEGOTIATION
  DOCUMENT
  MESSAGE
  ORDER_INTENT
  SYSTEM
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum MaritimeRfqStatus {
  ESTIMATED
  SUBMITTED
  EXPIRED
  CANCELLED
}

model Organization {
  id                   String                    @id @default(uuid())
  name                 String
  legalName            String?
  country              String?
  organizationType     OrganizationType          @default(BOTH)
  status               OrganizationStatus        @default(ACTIVE)
  memberships          Membership[]
  products             Product[]
  buyerRfqs            RFQ[]                     @relation("RFQBuyer")
  supplierRfqs         RFQ[]                     @relation("RFQSupplier")
  buyerQuotes          Quote[]                   @relation("QuoteBuyer")
  supplierQuotes       Quote[]                   @relation("QuoteSupplier")
  buyerOrderIntents    OrderIntent[]             @relation("OrderIntentBuyer")
  supplierOrderIntents OrderIntent[]             @relation("OrderIntentSupplier")
  auditLogs            AuditLog[]
  documents            CommercialDocument[]
  conversations        ConversationParticipant[]
  notifications        Notification[]
  buyerProfile         BuyerProfile?
  supplyCandidates     SupplyCandidate[]
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@index([status])
  @@index([country])
}

model User {
  id                String               @id @default(uuid())
  email             String               @unique
  passwordHash      String
  firstName         String?
  lastName          String?
  isActive          Boolean              @default(true)
  sessionVersion    Int                  @default(1)
  memberships       Membership[]
  refreshSessions   RefreshSession[]
  messages          Message[]
  uploadedDocuments CommercialDocument[] @relation("DocumentUploader")
  notifications     Notification[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([email])
}

model Membership {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  role           UserRole
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model RefreshSession {
  id             String    @id @default(uuid())
  userId         String
  organizationId String
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())

  @@index([userId, organizationId])
  @@index([expiresAt])
}

model Sector {
  id          String         @id @default(uuid())
  code        String         @unique
  name        String
  description String?
  policies    SectorPolicy[]
  products    Product[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model SectorPolicy {
  id                  String   @id @default(uuid())
  sectorId            String
  sector              Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  defaultCurrency     String   @default("USD")
  defaultUnit         String   @default("MT")
  minimumOrderQty     Decimal? @db.Decimal(18, 4)
  requiresCertificate Boolean  @default(false)
  requiresOrigin      Boolean  @default(false)
  requiresPackingList Boolean  @default(false)
  shippingRules       Json?
  requiredDocuments   Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([sectorId])
}

model Product {
  id             String            @id @default(uuid())
  organizationId String
  sectorId       String
  name           String
  slug           String
  description    String?
  status         ProductStatus     @default(DRAFT)
  visibility     CatalogVisibility @default(PRIVATE)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sector         Sector            @relation(fields: [sectorId], references: [id])
  skus           SKU[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([sectorId])
  @@index([visibility, status])
}

model SKU {
  id              String      @id @default(uuid())
  organizationId  String
  productId       String
  skuCode         String
  name            String
  unit            String
  minimumOrderQty Decimal     @db.Decimal(18, 4)
  currency        String      @default("USD")
  specifications  Json?
  shipping        Json?
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  media           Media[]
  rfqItems        RFQItem[]
  quoteItems      QuoteItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([organizationId, skuCode])
  @@index([organizationId])
  @@index([productId])
}

model Media {
  id        String    @id @default(uuid())
  skuId     String
  type      MediaType
  url       String
  sortOrder Int       @default(0)
  sku       SKU       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([skuId])
}

model RFQ {
  id                 String        @id @default(uuid())
  requirementId      String?       @unique
  buyerOrgId         String
  supplierOrgId      String?
  sectorId           String
  reference          String        @unique
  status             RFQStatus     @default(DRAFT)
  deliveryCountry    String?
  deliveryPort       String?
  incoterm           String?
  requestedDocuments Json?
  requestedDate      DateTime?
  notes              String?
  buyer              Organization  @relation("RFQBuyer", fields: [buyerOrgId], references: [id])
  supplier           Organization? @relation("RFQSupplier", fields: [supplierOrgId], references: [id])
  items              RFQItem[]
  quotes             Quote[]
  opportunities      Opportunity[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([buyerOrgId])
  @@index([requirementId])
  @@index([supplierOrgId])
  @@index([sectorId])
  @@index([status])
}

model RFQItem {
  id          String   @id @default(uuid())
  rfqId       String
  skuId       String
  quantity    Decimal  @db.Decimal(18, 4)
  unit        String
  targetPrice Decimal? @db.Decimal(18, 4)
  rfq         RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  sku         SKU      @relation(fields: [skuId], references: [id])
  createdAt   DateTime @default(now())

  @@index([rfqId])
  @@index([skuId])
}

model MaritimeRFQ {
  id                String             @id @default(uuid())
  reference         String             @unique
  idempotencyKey    String             @unique
  customerName      String
  company           String
  email             String
  phone             String
  containerCount    Int
  containerType     String
  teu               Int
  pol               String
  pod               String
  incoterm          String
  cargoType         String
  shipDate          DateTime
  grossWeight       Decimal?           @db.Decimal(18, 3)
  cbm               Decimal?           @db.Decimal(18, 3)
  finalDestinations Int                @default(1)
  paymentTerm       String?
  notes             String?
  sCode             String
  exclusiveName     String
  maritimeTerm      String
  priceMin          Decimal            @db.Decimal(18, 2)
  priceMax          Decimal            @db.Decimal(18, 2)
  currency          String             @default("USD")
  surcharges        Json
  validUntil        DateTime
  status            MaritimeRfqStatus  @default(SUBMITTED)
  audits            MaritimeRFQAudit[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([email, createdAt])
  @@index([sCode])
  @@index([status])
}

model MaritimeRFQAudit {
  id        String      @id @default(uuid())
  rfqId     String
  action    String
  metadata  Json?
  rfq       MaritimeRFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@index([rfqId, createdAt])
}

model Quote {
  id            String          @id @default(uuid())
  rfqId         String
  buyerOrgId    String
  supplierOrgId String
  status        QuoteStatus     @default(DRAFT)
  currency      String          @default("USD")
  validUntil    DateTime?
  paymentTerms  String?
  shippingTerms String?
  notes         String?
  rfq           RFQ             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  buyer         Organization    @relation("QuoteBuyer", fields: [buyerOrgId], references: [id])
  supplier      Organization    @relation("QuoteSupplier", fields: [supplierOrgId], references: [id])
  items         QuoteItem[]
  revisions     QuoteRevision[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([rfqId])
  @@index([buyerOrgId])
  @@index([supplierOrgId])
  @@index([status])
}

model QuoteRevision {
  id            String              @id @default(uuid())
  quoteId       String
  revisionNo    Int
  status        QuoteRevisionStatus @default(PROPOSED)
  currency      String
  validUntil    DateTime?
  paymentTerms  String?
  shippingTerms String?
  notes         String?
  snapshot      Json
  quote         Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now())

  @@unique([quoteId, revisionNo])
  @@index([quoteId, createdAt])
}

model QuoteItem {
  id        String   @id @default(uuid())
  quoteId   String
  skuId     String
  quantity  Decimal  @db.Decimal(18, 4)
  unitPrice Decimal  @db.Decimal(18, 4)
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sku       SKU      @relation(fields: [skuId], references: [id])
  createdAt DateTime @default(now())

  @@index([quoteId])
  @@index([skuId])
}

model OrderIntent {
  id            String            @id @default(uuid())
  quoteId       String            @unique
  buyerOrgId    String
  supplierOrgId String
  status        OrderIntentStatus @default(CREATED)
  buyer         Organization      @relation("OrderIntentBuyer", fields: [buyerOrgId], references: [id])
  supplier      Organization      @relation("OrderIntentSupplier", fields: [supplierOrgId], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([buyerOrgId])
  @@index([supplierOrgId])
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         AuditAction
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  metadata       Json?
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model CommercialDocument {
  id                       String              @id @default(uuid())
  organizationId           String
  uploadedById             String
  entityType               WorkspaceEntityType
  entityId                 String
  fileName                 String
  mimeType                 String
  byteSize                 BigInt
  storageKey               String              @unique
  sha256                   String
  status                   DocumentStatus      @default(PENDING)
  visibilityToCounterparty Boolean             @default(false)
  organization             Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy               User                @relation("DocumentUploader", fields: [uploadedById], references: [id])
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  @@index([organizationId, entityType, entityId])
  @@index([sha256])
}

model Conversation {
  id           String                    @id @default(uuid())
  entityType   WorkspaceEntityType
  entityId     String
  participants ConversationParticipant[]
  messages     Message[]
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType, entityId])
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  organizationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, organizationId])
  @@index([organizationId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderUserId   String
  senderOrgId    String
  type           MessageType  @default(TEXT)
  body           String
  documentId     String?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderUserId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderOrgId])
}

model Notification {
  id             String               @id @default(uuid())
  organizationId String
  userId         String?
  type           NotificationType
  title          String
  body           String
  entityType     WorkspaceEntityType?
  entityId       String?
  readAt         DateTime?
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())

  @@index([organizationId, readAt, createdAt])
  @@index([userId, readAt])
}

model OutboxEvent {
  id             String       @id @default(uuid())
  organizationId String
  type           String
  aggregateType  String
  aggregateId    String
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  availableAt    DateTime     @default(now())
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime     @default(now())

  @@index([status, availableAt])
  @@index([organizationId, createdAt])
}

enum DemandSignalType {
  TENDER
  RFQ
  AUCTION
}

enum DemandSignalStatus {
  WATCH
  RESOLVE_BUYER
  QUALIFY_NOW
  ARCHIVED
}

model DemandSignal {
  id                  String                 @id @default(uuid())
  source              String
  sourceRecordId      String
  sourceUrl           String?
  type                DemandSignalType
  status              DemandSignalStatus     @default(WATCH)
  market              String
  product             String
  quantity            String?
  buyerName           String?
  publishedAt         DateTime?
  deadlineAt          DateTime?
  incoterm            String?
  packing             String?
  evidence            Json?
  score               Int                    @default(0)
  verification        String                 @default("SOURCE_SIGNAL")
  intentPageCandidate Boolean                @default(false)
  raw                 Json?
  firstSeenAt         DateTime               @default(now())
  lastSeenAt          DateTime               @updatedAt
  requirements        QualifiedRequirement[]
  opportunities       Opportunity[]

  @@unique([source, sourceRecordId])
  @@index([status, score])
  @@index([market, product])
  @@index([publishedAt])
  @@index([deadlineAt])
}

enum IntelligenceVerificationStatus {
  UNVERIFIED
  SOURCE_CONFIRMED
  CROSS_VERIFIED
  HUMAN_VERIFIED
}

enum RequirementSource {
  AI_COMPOSER
  PRODUCT_FEED
  REORDER
  INTERNAL
}

enum WhatsAppReachability {
  UNCONFIRMED
  CONFIRMED
  UNREACHABLE
}

enum RequirementStatus {
  DRAFT
  NEEDS_CLARIFICATION
  QUALIFIED
  SUPPLY_READY
  ARCHIVED
}

enum OpportunityStatus {
  DISCOVERED
  BUYER_RESOLUTION
  QUALIFICATION
  SUPPLY_MATCHING
  DEAL_BUILDING
  AWAITING_APPROVAL
  APPROVED
  WON
  LOST
  ARCHIVED
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  NEEDS_HUMAN
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalAction {
  START_SUPPLY_MATCHING
  BUILD_DEAL
  SEND_RFQ
  SEND_QUOTE
  ACCEPT_COMMERCIAL_TERMS
  CREATE_ORDER_INTENT
  EXTERNAL_COMMITMENT
}

model BuyerProfile {
  id                 String                         @id @default(uuid())
  organizationId     String?                        @unique
  canonicalName      String
  country            String?
  website            String?
  industry           String?
  verificationStatus IntelligenceVerificationStatus @default(UNVERIFIED)
  confidence         Int                            @default(0)
  attributes         Json?
  provenance         Json?
  organization       Organization?                  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  requirements       QualifiedRequirement[]
  contacts           BuyerContact[]
  opportunities      Opportunity[]
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  @@index([canonicalName])
  @@index([country, industry])
}

model BuyerContact {
  id                   String                 @id @default(uuid())
  buyerProfileId       String?
  name                 String
  company              String
  whatsapp             String
  email                String?
  whatsappReachability WhatsAppReachability   @default(UNCONFIRMED)
  buyerProfile         BuyerProfile?          @relation(fields: [buyerProfileId], references: [id], onDelete: SetNull)
  requirements         QualifiedRequirement[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([whatsapp])
  @@index([email])
  @@index([buyerProfileId])
}

model QualifiedRequirement {
  id                   String            @id @default(uuid())
  buyerProfileId       String?
  buyerContactId       String?
  sourceSignalId       String?
  organizationId       String?
  source               RequirementSource @default(AI_COMPOSER)
  sourceContext        Json?
  status               RequirementStatus @default(DRAFT)
  product              String
  market               String
  quantity             Decimal?          @db.Decimal(18, 4)
  unit                 String?
  containerCount       Int?
  septlionScale        String?
  deliveryCountry      String?
  deliveryPort         String?
  destinationCode      String?
  incoterm             String?
  paymentPreference    String?
  targetPrice          Decimal?          @db.Decimal(18, 4)
  currency             String?
  requiredDate         DateTime?
  knownFacts           Json
  inferredFacts        Json?
  fieldStates          Json?
  criticalMissing      Json?
  productConfiguration Json?
  specifications       Json?
  packing              Json?
  compliance           Json?
  confidence           Int               @default(0)
  buyerProfile         BuyerProfile?     @relation(fields: [buyerProfileId], references: [id], onDelete: SetNull)
  buyerContact         BuyerContact?     @relation(fields: [buyerContactId], references: [id], onDelete: SetNull)
  sourceSignal         DemandSignal?     @relation(fields: [sourceSignalId], references: [id], onDelete: SetNull)
  opportunities        Opportunity[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([status, market, product])
  @@index([organizationId, updatedAt])
  @@index([buyerProfileId])
  @@index([buyerContactId])
  @@index([sourceSignalId])
  @@index([source, createdAt])
}

model Opportunity {
  id               String                @id @default(uuid())
  reference        String                @unique
  status           OpportunityStatus     @default(DISCOVERED)
  sourceSignalId   String?
  buyerProfileId   String?
  requirementId    String?
  rfqId            String?
  title            String
  market           String
  product          String
  commercialValue  Decimal?              @db.Decimal(18, 2)
  currency         String?
  nextAction       String?
  nextActionAt     DateTime?
  evidence         Json?
  risk             Json?
  economics        Json?
  humanApproval    Json?
  sourceSignal     DemandSignal?         @relation(fields: [sourceSignalId], references: [id], onDelete: SetNull)
  buyerProfile     BuyerProfile?         @relation(fields: [buyerProfileId], references: [id], onDelete: SetNull)
  requirement      QualifiedRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  rfq              RFQ?                  @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  agentRuns        AgentRun[]
  approvals        HumanApproval[]
  supplyCandidates SupplyCandidate[]
  dealDrafts       DealDraft[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([status, updatedAt])
  @@index([market, product])
  @@index([sourceSignalId])
  @@index([buyerProfileId])
  @@index([requirementId])
}

model AgentRun {
  id            String         @id @default(uuid())
  opportunityId String?
  agentType     String
  runtime       String?
  status        AgentRunStatus @default(QUEUED)
  input         Json
  output        Json?
  evidence      Json?
  error         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  opportunity   Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())

  @@index([status, createdAt])
  @@index([opportunityId, agentType])
}

model HumanApproval {
  id            String           @id @default(uuid())
  opportunityId String
  action        ApprovalAction
  decision      ApprovalDecision @default(PENDING)
  title         String
  summary       String?
  payload       Json?
  decidedBy     String?
  decidedAt     DateTime?
  opportunity   Opportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([decision, createdAt])
  @@index([opportunityId, action])
}

model SupplyCandidate {
  id            String        @id @default(uuid())
  opportunityId String
  supplierOrgId String?
  supplierName  String
  country       String?
  source        String?
  sourceUrl     String?
  capability    Json?
  compliance    Json?
  commercial    Json?
  logistics     Json?
  confidence    Int           @default(0)
  verified      Boolean       @default(false)
  opportunity   Opportunity   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  supplierOrg   Organization? @relation(fields: [supplierOrgId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([opportunityId, confidence])
  @@index([supplierOrgId])
}

model DealDraft {
  id             String      @id @default(uuid())
  opportunityId  String
  version        Int         @default(1)
  currency       String      @default("USD")
  exWorks        Decimal?    @db.Decimal(18, 2)
  freight        Decimal?    @db.Decimal(18, 2)
  qc             Decimal?    @db.Decimal(18, 2)
  documents      Decimal?    @db.Decimal(18, 2)
  duties         Decimal?    @db.Decimal(18, 2)
  riskReserve    Decimal?    @db.Decimal(18, 2)
  landedCost     Decimal?    @db.Decimal(18, 2)
  grossMarginPct Decimal?    @db.Decimal(8, 4)
  offerPrice     Decimal?    @db.Decimal(18, 2)
  assumptions    Json?
  status         String      @default("DRAFT")
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([opportunityId, version])
  @@index([opportunityId, createdAt])
}


/// Immutable commercial truth created only from an accepted quote revision.
model CommercialLock {
  id             String   @id @default(uuid())
  quoteId        String   @unique
  quoteRevisionId String  @unique
  orderIntentId  String?  @unique
  buyerOrgId     String
  supplierOrgId  String
  version        Int      @default(1)
  snapshot       Json
  snapshotHash   String
  lockedByUserId String?
  lockedAt       DateTime @default(now())
  transaction    TradeTransaction?
  changeOrders   ChangeOrder[]

  @@index([buyerOrgId, lockedAt])
  @@index([supplierOrgId, lockedAt])
}

/// Durable execution aggregate. Buyer-visible state is projected from TradeEvent facts.
model TradeTransaction {
  id               String                 @id @default(uuid())
  reference        String                 @unique
  commercialLockId String                 @unique
  buyerOrgId       String
  supplierOrgId    String
  status           TradeTransactionStatus @default(PENDING_COMMIT)
  version          Int                    @default(1)
  commercialLock   CommercialLock         @relation(fields: [commercialLockId], references: [id], onDelete: Restrict)
  events           TradeEvent[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([buyerOrgId, status, updatedAt])
  @@index([supplierOrgId, status, updatedAt])
}

/// Append-only execution fact. Existing events must never be updated to rewrite history.
model TradeEvent {
  id            String               @id @default(uuid())
  transactionId String
  sequence      Int
  type          String
  visibility    TradeEventVisibility @default(INTERNAL)
  actorOrgId    String?
  actorUserId   String?
  occurredAt    DateTime
  payload       Json
  evidence      Json?
  idempotencyKey String?             @unique
  transaction   TradeTransaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now())

  @@unique([transactionId, sequence])
  @@index([transactionId, occurredAt])
  @@index([type, occurredAt])
}

/// Explicit post-lock commercial change; approved changes never mutate the original lock.
model ChangeOrder {
  id               String            @id @default(uuid())
  commercialLockId String
  number           Int
  status           ChangeOrderStatus @default(PROPOSED)
  requestedByOrgId String
  requestedByUserId String?
  reason           String
  patch            Json
  impact           Json?
  approvedByUserId String?
  approvedAt       DateTime?
  commercialLock   CommercialLock    @relation(fields: [commercialLockId], references: [id], onDelete: Restrict)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([commercialLockId, number])
  @@index([commercialLockId, status])
}
