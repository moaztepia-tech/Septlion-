DATABASE_URL=postgresql://septlion:septlion_dev@localhost:5432/septlion?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
NEXT_PUBLIC_API_URL=http://localhost:4000/api
CORS_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
# Production: use a dedicated PostgreSQL worker role with the minimum grants required for Outbox/Notification processing.
WORKER_DATABASE_URL=postgresql://septlion_worker:change-me@localhost:5432/septlion?schema=public

# Global Demand Engine
DEMAND_COLLECTOR_ENABLED=false
DEMAND_COLLECTOR_INTERVAL_MINUTES=360
AGENT_WORKER_ENABLED=false
AGENT_WORKER_INTERVAL_SECONDS=30
# External agent runtime adapter (OpenDots or another compatible worker)
AGENT_RUNTIME_WEBHOOK_URL=
AGENT_RUNTIME_TOKEN=

# Optional first admin provisioned by prisma seed
SEPTLION_ADMIN_EMAIL=
SEPTLION_ADMIN_PASSWORD=

# Demand source expansion
DEMAND_TERMS=wheat flour,flour,milling,maize flour,fortified flour
DEMAND_JSON_FEED_URL=
DEMAND_JSON_FEED_TOKEN=
