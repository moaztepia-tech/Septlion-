# Full Next.js runtime. No production secret or verification bypass is baked in.
FROM node:22-bookworm-slim AS app
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile --filter @septlion/web... --ignore-scripts
COPY scripts/assert-staging-config.mjs scripts/assert-staging-config.mjs
COPY apps/web apps/web
COPY packages/shared packages/shared
ARG SEPTLION_DEPLOYMENT=staging
ENV SEPTLION_DEPLOYMENT=$SEPTLION_DEPLOYMENT
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @septlion/web build
RUN chown -R node:node /app/apps/web/.next
ENV NODE_ENV=production PORT=3000
USER node
EXPOSE 3000
CMD ["sh","-c","exec pnpm --filter @septlion/web exec next start --hostname 0.0.0.0 --port \"$PORT\""]
