{
  "name": "septlion",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @septlion/web dev",
    "build": "pnpm --filter @septlion/web build",
    "typecheck": "pnpm --filter @septlion/web typecheck",
    "db:generate": "pnpm --filter @septlion/api prisma:generate",
    "db:migrate": "pnpm --filter @septlion/api prisma:migrate",
    "db:seed": "pnpm --filter @septlion/api prisma:seed",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1"
  },
  "pnpm": {
    "overrides": {
      "multer": "2.5.0",
      "tar": "7.5.21",
      "glob": "10.5.0",
      "tmp": "0.2.6",
      "webpack": "5.104.1",
      "postcss": "8.5.23",
      "qs": "6.16.0",
      "picomatch": "4.0.4",
      "source-map-js": "1.2.2",
      "postcss-selector-parser": "7.1.6",
      "fast-uri": "3.1.9",
      "deepmerge-ts": "8.0.0",
      "file-type": "21.3.2",
      "body-parser@<1.20.9": "1.20.9",
      "ajv@>=7 <8.18.0": "8.18.0"
    }
  }
}
